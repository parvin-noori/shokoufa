generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  rate         Float
  price        Int
  discount     Int            @default(0)
  isBestSeller Boolean        @default(false)
  stock        Int            @default(0)
  flowerType   FlowerType
  occasion     Occasion[]
  style        Style
  size         Size
  colors       Color[]
  createdAt    DateTime       @default(now())
  images       ProductImage[]
  reviews      Review[]
  categories   Category[]     @relation("CategoryToProduct")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("CategoryToProduct")
}

model Review {
  id        String   @id @default(cuid())
  username  String
  comment   String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([username, productId])
}

model Post {
  id        String   @id @default(cuid())
  image_url String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slug      String?  @unique
}

enum FlowerType {
  tulip
  rose
  lily
  orchid
  sunflower
  hundredToman
  mixed
  peony
}

enum Occasion {
  birthday
  condolence
  anniversary
  wedding
  graduation
  mothersDay
  girlsDay
  fathersDay
  boysDay
}

enum Style {
  modern
  classic
  simple
  minimal
  luxury
}

enum Size {
  small
  medium
  large
}

enum Color {
  pink
  white
  purple
  blue
  yellow
  turquoise
  red
  orange
  cream
}
